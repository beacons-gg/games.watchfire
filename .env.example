# Settings for `docker compose up`: copy to .env and uncomment what you change. Unset settings
# take the door's own defaults (shown). See docs/deploy.md and docs/ssh-door.md.

# The port players ssh to on this host. 22 makes it `ssh <host>`, if the host's own sshd is moved.
# WATCHFIRE_DOOR_PUBLIC_PORT=2222

# The port of the website (the game explained, its world live, how to join).
# WATCHFIRE_WEB_PUBLIC_PORT=8080

# The join command the website shows. By default it's `ssh -p <port> <the address the visitor
# used>`, which is right on a home network; set it when players should use a name instead.
# WATCHFIRE_JOIN=ssh -p 2222 watchfire.home

# Where the website's Download button goes. By default the latest GitHub release; "none" for no
# download, only the door.
# WATCHFIRE_DOWNLOAD=https://example.org/watchfire/download

# Servers a new keeper starts with (comma-separated).
# WATCHFIRE_SERVERS=https://9q72.beacons.gg

# Required. The master key that seals every keeper's recovery phrase: 32 random bytes, hex (or
# base64). Make it once: openssl rand -hex 32
# Lose it and every keeper on this door is lost. Back it up somewhere other than this host.
# WATCHFIRE_MASTER_KEY=

# Required (unless the data is kept in files, below). The database's password, set when the
# database is first made: openssl rand -hex 24
# WATCHFIRE_DB_PASSWORD=

# Keep the door's data in files (the door-data volume) instead of Postgres: no database runs.
# COMPOSE_FILE=compose.yaml:compose.files.yaml

# WATCHFIRE_DOOR_MAX_SESSIONS=50
# WATCHFIRE_DOOR_MAX_PER_IP=5
# WATCHFIRE_DOOR_IDLE_MINUTES=5
# WATCHFIRE_DOOR_MAX_MINUTES=60
# WATCHFIRE_DOOR_WRITES_PER_MINUTE=100
