# Settings for `docker compose up`: copy to .env and uncomment what you change. Unset settings
# take the door's own defaults (shown). See docs/deploy.md and docs/ssh-door.md.

# The port players ssh to on this host. 22 makes it `ssh <host>`, if the host's own sshd is moved.
# WATCHFIRE_DOOR_PUBLIC_PORT=2222

# Servers a new keeper starts with (comma-separated).
# WATCHFIRE_SERVERS=https://9q72.beacons.gg

# The file holding the master key that seals every keeper's recovery phrase (32 random bytes,
# base64): openssl rand -base64 32 > secrets/master.key
# Lose it and every keeper on this door is lost. Back it up somewhere other than the data volume.
# WATCHFIRE_MASTER_KEY_FILE=./secrets/master.key

# Your npm credentials for the private @beaconsgg registry, used only while building the image.
# NPMRC=~/.npmrc

# WATCHFIRE_DOOR_MAX_SESSIONS=50
# WATCHFIRE_DOOR_MAX_PER_IP=5
# WATCHFIRE_DOOR_IDLE_MINUTES=5
# WATCHFIRE_DOOR_MAX_MINUTES=60
# WATCHFIRE_DOOR_WRITES_PER_MINUTE=100
