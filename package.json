{
  "name": "watchfire",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "typecheck": "tsc -p . && tsc -p apps/dashboard",
    "test": "node --test \"packages/*/test/*.test.ts\" \"apps/*/test/*.test.ts\"",
    "spike": "node scripts/spike-fire.ts",
    "spike:profile": "node scripts/spike-profile.ts",
    "play": "pnpm -C apps/cli run dev",
    "build": "pnpm --filter watchfire --filter @watchfire/dashboard build",
    "spike:servers": "node scripts/spike-servers.ts",
    "servers:up": "BEACON_ADMINS=$(node scripts/local-operator.ts did) docker compose -f scripts/local-servers/compose.yaml up -d --wait",
    "servers:down": "docker compose -f scripts/local-servers/compose.yaml down -v",
    "door": "pnpm -C apps/door run dev",
    "dashboard": "pnpm -C apps/dashboard run dev"
  },
  "devDependencies": {
    "@beaconsgg/client-sdk": "^1.1.0",
    "@types/node": "^26.6.6",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@beaconsgg/geo": "^1.1.0",
    "@beaconsgg/identity": "^1.1.0",
    "@watchfire/core": "workspace:*",
    "socket.io-client": "^4.8.4"
  }
}
